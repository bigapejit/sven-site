---
interface Props {
  title: string;
  episode: string;
  duration: string;
  audioUrl: string;
  imageUrl: string;
  date: string;
  index: number;
}

const { title, episode, duration, audioUrl, imageUrl, date, index } = Astro.props;
---

<button
  class="group w-full text-left p-4 rounded-2xl border border-border bg-surface hover:bg-surface-hover transition-all duration-200 cursor-pointer"
  data-audio-url={audioUrl}
  data-title={title}
  data-episode={episode}
  data-image={imageUrl}
  data-date={date}
>
  <div class="flex items-center gap-4">
    <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-purple/10 border border-purple/20 flex items-center justify-center group-hover:bg-purple/20 transition-colors">
      <svg class="w-4 h-4 text-purple play-icon" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z" />
      </svg>
    </div>
    <div class="flex-1 min-w-0">
      <p class="text-sm font-medium text-text truncate">{title}</p>
      <p class="text-xs text-text-muted mt-0.5">
        {episode && <span>Ep. {episode}</span>}
        {episode && duration && <span class="mx-1.5">·</span>}
        {duration && <span>{duration}</span>}
      </p>
    </div>
  </div>
</button>
