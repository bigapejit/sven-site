---
---

<!-- Full-screen player overlay -->
<div id="fullscreen-player" class="fixed inset-0 z-[60] translate-y-full transition-transform duration-500 ease-out will-change-transform">
  <!-- Blurred background -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      id="fs-bg"
      src="/fallback-artwork.svg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover scale-125 blur-[80px] opacity-60"
    />
    <div class="absolute inset-0 bg-[#1a0a2e]/70"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full safe-area-inset">
    <!-- Top bar -->
    <div class="flex items-center px-6 pt-6 pb-2">
      <!-- Desktop: X close button (top-left) -->
      <button id="fs-close-desktop" class="hidden md:flex w-10 h-10 items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer" title="Close">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M6 6l12 12M18 6L6 18"/>
        </svg>
      </button>

      <!-- Mobile: chevron-down (top center) -->
      <div class="flex-1 flex justify-center md:hidden">
        <button id="fs-close-mobile" class="w-10 h-10 flex items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer" title="Close">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>

      <!-- Spacer for desktop layout -->
      <div class="hidden md:flex flex-1"></div>

      <!-- Desktop: volume (top-right) -->
      <div id="fs-volume-desktop" class="hidden md:flex items-center gap-2">
        <button id="fs-volume-icon" class="w-8 h-8 flex items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer" title="Toggle mute">
          <svg id="fs-icon-volume-on" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
          </svg>
          <svg id="fs-icon-volume-off" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4l-1.88 1.88L12 7.76V4z"/>
          </svg>
        </button>
        <input
          id="fs-volume-slider"
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="1"
          class="w-24 h-1 accent-white cursor-pointer"
        />
      </div>
    </div>

    <!-- Center content -->
    <div id="fs-center" class="flex-1 flex flex-col items-center justify-center px-6 overflow-hidden min-h-0">
      <!-- Art view (default) -->
      <div id="fs-art-view" class="flex flex-col items-center">
        <!-- Large album art -->
        <img
          id="fs-art"
          src="/fallback-artwork.svg"
          alt="Episode artwork"
          class="w-64 h-64 md:w-72 md:h-72 lg:w-80 lg:h-80 rounded-2xl object-cover shadow-2xl shadow-black/50"
        />

        <!-- Metadata -->
        <div class="mt-8 text-center w-full max-w-md">
          <p id="fs-date" class="text-sm text-white/60"></p>
          <div class="flex items-center justify-center gap-2 mt-1">
            <h2 id="fs-title" class="text-xl md:text-2xl font-bold text-white truncate">Select an episode</h2>
            <div class="relative flex-shrink-0">
              <button id="fs-share-btn" class="w-8 h-8 flex items-center justify-center text-white/60 hover:text-white transition-colors cursor-pointer" title="Share episode">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
                </svg>
              </button>
              <span id="fs-share-toast" class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-white text-[#1a0a2e] text-xs font-semibold rounded opacity-0 pointer-events-none transition-opacity whitespace-nowrap">Copied!</span>
            </div>
          </div>
          <p id="fs-subtitle" class="text-sm text-white/50 mt-1"></p>
        </div>
      </div>

      <!-- Up Next panel -->
      <div id="fs-up-next-panel" class="hidden w-full max-w-md flex-1 flex flex-col min-h-0 pt-2">
        <div class="flex items-center gap-3 p-3 bg-white/10 rounded-xl mb-4 flex-shrink-0">
          <img id="un-current-art" src="/fallback-artwork.svg" alt="" class="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
          <div class="flex-1 min-w-0">
            <p id="un-current-title" class="text-sm font-semibold text-white truncate"></p>
            <p id="un-current-date" class="text-xs text-white/60"></p>
          </div>
          <button id="un-share-btn" class="w-8 h-8 flex items-center justify-center text-white/60 hover:text-white transition-colors cursor-pointer flex-shrink-0" title="Share episode">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
            </svg>
          </button>
        </div>
        <p class="text-xs uppercase tracking-wider text-white/40 mb-2 px-1 flex-shrink-0">Up Next</p>
        <div id="un-list" class="flex-1 overflow-y-auto min-h-0 overscroll-contain"></div>
        <div id="un-empty" class="hidden flex-1 items-center justify-center">
          <p class="text-white/40 text-sm">Nothing Playing Next</p>
        </div>
      </div>

      <!-- Progress bar -->
      <div class="w-full max-w-md mt-8 flex-shrink-0">
        <div id="fs-progress-bar" class="relative w-full h-[3px] bg-white/20 rounded-full cursor-pointer group">
          <div id="fs-progress-fill" class="absolute left-0 top-0 h-full bg-white rounded-full" style="width: 0%"></div>
          <div id="fs-progress-thumb" class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-md" style="left: 0%"></div>
        </div>
        <div class="flex justify-between mt-2 text-xs text-white/60 tabular-nums">
          <span id="fs-current-time">0:00</span>
          <span id="fs-remaining-time">-0:00</span>
        </div>
      </div>

      <!-- Playback controls -->
      <div class="flex items-center gap-6 mt-8 flex-shrink-0">
        <!-- Speed -->
        <button id="fs-speed-btn" class="w-12 h-8 rounded-full border border-white/30 text-sm font-semibold text-white/70 hover:text-white hover:border-white/60 transition-colors cursor-pointer" title="Playback speed">
          1x
        </button>

        <!-- Skip back 15s -->
        <button id="fs-skip-back" class="w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer" title="Back 15s">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12.5 8V4l-4 4 4 4V8c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4.5c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
            <text x="10" y="16.5" fill="currentColor" stroke="none" font-size="7" font-weight="600" text-anchor="middle">15</text>
          </svg>
        </button>

        <!-- Play/Pause -->
        <button id="fs-play-pause" class="w-16 h-16 rounded-full bg-white flex items-center justify-center hover:scale-105 transition-transform cursor-pointer">
          <svg id="fs-icon-play" class="w-7 h-7 text-[#1a0a2e] ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg id="fs-icon-pause" class="w-7 h-7 text-[#1a0a2e] hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 4h4v16H6zm8 0h4v16h-4z"/>
          </svg>
        </button>

        <!-- Skip forward 30s -->
        <button id="fs-skip-forward" class="w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-colors cursor-pointer" title="Forward 30s">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11.5 8V4l4 4-4 4V8c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
            <text x="14" y="16.5" fill="currentColor" stroke="none" font-size="7" font-weight="600" text-anchor="middle">30</text>
          </svg>
        </button>

        <!-- Up Next toggle -->
        <button id="fs-up-next-btn" class="w-12 h-8 flex items-center justify-center text-white/40 hover:text-white transition-colors cursor-pointer" title="Up Next">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h10"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile: volume (bottom) -->
    <div id="fs-volume-mobile" class="flex md:hidden items-center gap-3 px-8 pb-8 pt-2">
      <button id="fs-volume-icon-mobile" class="w-8 h-8 flex items-center justify-center text-white/60 cursor-pointer" title="Mute">
        <svg id="fs-icon-vol-mute-mobile" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3z"/>
        </svg>
      </button>
      <input
        id="fs-volume-slider-mobile"
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="1"
        class="flex-1 h-1 accent-white cursor-pointer"
      />
      <div class="w-8 h-8 flex items-center justify-center text-white/60">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- Mini player bar -->
<div id="player" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-300">
  <div class="bg-surface/95 backdrop-blur-xl border-t border-border">
    <div class="max-w-2xl mx-auto px-4 py-3">
      <!-- Progress bar -->
      <div class="relative w-full h-1 bg-border rounded-full mb-3 cursor-pointer group" id="progress-bar">
        <div class="absolute left-0 top-0 h-full bg-gradient-to-r from-purple to-neon rounded-full transition-all" id="progress-fill" style="width: 0%"></div>
        <div class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-neon rounded-full opacity-0 group-hover:opacity-100 transition-opacity" id="progress-thumb" style="left: 0%"></div>
      </div>

      <!-- Desktop layout (≥768px) -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Album art (clickable to open fullscreen) -->
        <img
          id="player-art"
          src="/fallback-artwork.svg"
          alt="Episode artwork"
          class="w-11 h-11 rounded-lg object-cover flex-shrink-0 transition-transform duration-200 hover:scale-105 cursor-pointer"
        />

        <!-- Title & date -->
        <div class="flex-1 min-w-0">
          <p id="player-title" class="text-sm font-medium text-text truncate">Select an episode</p>
          <p id="player-date" class="text-xs text-text-muted truncate"></p>
        </div>

        <!-- Transport controls -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <!-- Skip back 15s -->
          <button id="skip-back" class="w-8 h-8 flex items-center justify-center text-text-muted hover:text-text transition-colors cursor-pointer" title="Back 15s">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12.5 8V4l-4 4 4 4V8c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4.5c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
              <text x="10" y="16.5" fill="currentColor" stroke="none" font-size="7" font-weight="600" text-anchor="middle">15</text>
            </svg>
          </button>

          <!-- Play/Pause -->
          <button id="play-pause" class="flex-shrink-0 w-10 h-10 rounded-full bg-purple flex items-center justify-center hover:bg-purple-glow transition-colors cursor-pointer">
            <svg id="icon-play" class="w-4 h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg id="icon-pause" class="w-4 h-4 text-white hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6zm8 0h4v16h-4z" />
            </svg>
          </button>

          <!-- Skip forward 30s -->
          <button id="skip-forward" class="w-8 h-8 flex items-center justify-center text-text-muted hover:text-text transition-colors cursor-pointer" title="Forward 30s">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M11.5 8V4l4 4-4 4V8c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
              <text x="14" y="16.5" fill="currentColor" stroke="none" font-size="7" font-weight="600" text-anchor="middle">30</text>
            </svg>
          </button>
        </div>

        <!-- Speed button -->
        <button id="speed-btn" class="flex-shrink-0 w-10 h-6 rounded-full border border-border text-xs font-semibold text-text-muted hover:text-text hover:border-purple/50 transition-colors cursor-pointer" title="Playback speed">
          1x
        </button>

        <!-- Volume -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <button id="volume-icon" class="w-7 h-7 flex items-center justify-center text-text-muted hover:text-text transition-colors cursor-pointer" title="Toggle mute">
            <svg id="icon-volume-on" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
            </svg>
            <svg id="icon-volume-off" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4l-1.88 1.88L12 7.76V4z"/>
            </svg>
          </button>
          <input
            id="volume-slider"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value="1"
            class="w-20 h-1 accent-purple cursor-pointer"
          />
        </div>

        <!-- Up Next placeholder -->
        <button id="up-next-btn" class="w-7 h-7 flex items-center justify-center text-text-muted hover:text-text transition-colors cursor-pointer opacity-50" title="Up Next">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h10"/>
          </svg>
        </button>

        <!-- Time -->
        <div class="flex-shrink-0 text-xs text-text-muted tabular-nums">
          <span id="current-time">0:00</span>
          <span class="mx-0.5">/</span>
          <span id="total-time">0:00</span>
        </div>
      </div>

      <!-- Mobile layout (<768px) -->
      <div id="mobile-bar" class="flex md:hidden items-center gap-3 cursor-pointer">
        <!-- Album art -->
        <img
          id="player-art-mobile"
          src="/fallback-artwork.svg"
          alt="Episode artwork"
          class="w-10 h-10 rounded-lg object-cover flex-shrink-0"
        />

        <!-- Info -->
        <div class="flex-1 min-w-0">
          <p id="player-podcast-mobile" class="text-[10px] uppercase tracking-wider text-text-muted truncate">You vs Who</p>
          <p id="player-title-mobile" class="text-sm font-medium text-text truncate">Select an episode</p>
        </div>

        <!-- Mobile controls -->
        <div class="flex items-center gap-1 flex-shrink-0" id="mobile-controls">
          <!-- Play/Pause -->
          <button id="play-pause-mobile" class="w-9 h-9 rounded-full bg-purple flex items-center justify-center hover:bg-purple-glow transition-colors cursor-pointer">
            <svg id="icon-play-mobile" class="w-4 h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg id="icon-pause-mobile" class="w-4 h-4 text-white hidden" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6zm8 0h4v16h-4z" />
            </svg>
          </button>

          <!-- Skip forward 30s -->
          <button id="skip-forward-mobile" class="w-8 h-8 flex items-center justify-center text-text-muted hover:text-text transition-colors cursor-pointer" title="Forward 30s">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M11.5 8V4l4 4-4 4V8c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6h2c0 4.42-3.58 8-8 8s-8-3.58-8-8 3.58-8 8-8z"/>
              <text x="14" y="16.5" fill="currentColor" stroke="none" font-size="7" font-weight="600" text-anchor="middle">30</text>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<audio id="audio" preload="metadata"></audio>

<script>
  const audio = document.getElementById('audio') as HTMLAudioElement;
  const player = document.getElementById('player')!;
  const progressBar = document.getElementById('progress-bar')!;
  const progressFill = document.getElementById('progress-fill')!;
  const progressThumb = document.getElementById('progress-thumb')!;

  // Desktop elements
  const playPause = document.getElementById('play-pause')!;
  const iconPlay = document.getElementById('icon-play')!;
  const iconPause = document.getElementById('icon-pause')!;
  const playerTitle = document.getElementById('player-title')!;
  const playerDate = document.getElementById('player-date')!;
  const playerArt = document.getElementById('player-art') as HTMLImageElement;
  const currentTimeEl = document.getElementById('current-time')!;
  const totalTimeEl = document.getElementById('total-time')!;
  const skipBack = document.getElementById('skip-back')!;
  const skipForward = document.getElementById('skip-forward')!;
  const speedBtn = document.getElementById('speed-btn')!;
  const volumeIcon = document.getElementById('volume-icon')!;
  const iconVolumeOn = document.getElementById('icon-volume-on')!;
  const iconVolumeOff = document.getElementById('icon-volume-off')!;
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;

  // Mobile elements
  const playPauseMobile = document.getElementById('play-pause-mobile')!;
  const iconPlayMobile = document.getElementById('icon-play-mobile')!;
  const iconPauseMobile = document.getElementById('icon-pause-mobile')!;
  const playerTitleMobile = document.getElementById('player-title-mobile')!;
  const playerArtMobile = document.getElementById('player-art-mobile') as HTMLImageElement;
  const skipForwardMobile = document.getElementById('skip-forward-mobile')!;
  const mobileBar = document.getElementById('mobile-bar')!;
  const mobileControls = document.getElementById('mobile-controls')!;

  // Fullscreen player elements
  const fsPlayer = document.getElementById('fullscreen-player')!;
  const fsBg = document.getElementById('fs-bg') as HTMLImageElement;
  const fsArt = document.getElementById('fs-art') as HTMLImageElement;
  const fsTitle = document.getElementById('fs-title')!;
  const fsDate = document.getElementById('fs-date')!;
  const fsSubtitle = document.getElementById('fs-subtitle')!;
  const fsProgressBar = document.getElementById('fs-progress-bar')!;
  const fsProgressFill = document.getElementById('fs-progress-fill')!;
  const fsProgressThumb = document.getElementById('fs-progress-thumb')!;
  const fsCurrentTime = document.getElementById('fs-current-time')!;
  const fsRemainingTime = document.getElementById('fs-remaining-time')!;
  const fsPlayPause = document.getElementById('fs-play-pause')!;
  const fsIconPlay = document.getElementById('fs-icon-play')!;
  const fsIconPause = document.getElementById('fs-icon-pause')!;
  const fsSkipBack = document.getElementById('fs-skip-back')!;
  const fsSkipForward = document.getElementById('fs-skip-forward')!;
  const fsSpeedBtn = document.getElementById('fs-speed-btn')!;
  const fsCloseDesktop = document.getElementById('fs-close-desktop')!;
  const fsCloseMobile = document.getElementById('fs-close-mobile')!;
  const fsVolumeIcon = document.getElementById('fs-volume-icon')!;
  const fsIconVolumeOn = document.getElementById('fs-icon-volume-on')!;
  const fsIconVolumeOff = document.getElementById('fs-icon-volume-off')!;
  const fsVolumeSlider = document.getElementById('fs-volume-slider') as HTMLInputElement;
  const fsVolumeIconMobile = document.getElementById('fs-volume-icon-mobile')!;
  const fsVolumeSliderMobile = document.getElementById('fs-volume-slider-mobile') as HTMLInputElement;
  const fsShareBtn = document.getElementById('fs-share-btn')!;
  const fsShareToast = document.getElementById('fs-share-toast')!;

  const SPEED_OPTIONS = [1, 1.5, 2, 0.5];
  let speedIndex = 0;
  let volumeBeforeMute = 1;
  let currentRawDate = '';
  let fsOpen = false;

  function formatTime(seconds: number): string {
    const hrs = Math.floor(seconds / 3600);
    const mins = Math.floor((seconds % 3600) / 60);
    const secs = Math.floor(seconds % 60);
    if (hrs > 0) {
      return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  function formatRemainingTime(seconds: number): string {
    return `-${formatTime(seconds)}`;
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function showPlayer() {
    player.classList.remove('translate-y-full');
    player.classList.add('translate-y-0');
  }

  function updateIcons(playing: boolean) {
    iconPlay.classList.toggle('hidden', playing);
    iconPause.classList.toggle('hidden', !playing);
    iconPlayMobile.classList.toggle('hidden', playing);
    iconPauseMobile.classList.toggle('hidden', !playing);
    fsIconPlay.classList.toggle('hidden', playing);
    fsIconPause.classList.toggle('hidden', !playing);
  }

  function updateVolumeIcon() {
    const muted = audio.muted || audio.volume === 0;
    iconVolumeOn.classList.toggle('hidden', muted);
    iconVolumeOff.classList.toggle('hidden', !muted);
    fsIconVolumeOn.classList.toggle('hidden', muted);
    fsIconVolumeOff.classList.toggle('hidden', !muted);
  }

  function updateSpeedDisplay() {
    const speed = SPEED_OPTIONS[speedIndex];
    const label = speed === 1 ? '1x' : `${speed}x`;
    speedBtn.textContent = label;
    fsSpeedBtn.textContent = label;
  }

  function syncVolumeSliders() {
    const val = String(audio.volume);
    volumeSlider.value = val;
    fsVolumeSlider.value = val;
    fsVolumeSliderMobile.value = val;
  }

  // --- Fullscreen player open/close ---

  function openFullscreen() {
    if (!audio.src) return;
    fsOpen = true;
    fsPlayer.classList.remove('translate-y-full');
    fsPlayer.classList.add('translate-y-0');
    document.body.style.overflow = 'hidden';
  }

  function closeFullscreen() {
    fsOpen = false;
    if (upNextVisible) toggleUpNext();
    fsPlayer.classList.remove('translate-y-0');
    fsPlayer.classList.add('translate-y-full');
    document.body.style.overflow = '';
  }

  function updateFullscreenData(title: string, imageUrl: string, dateStr: string) {
    fsArt.src = imageUrl;
    fsBg.src = imageUrl;
    fsTitle.textContent = title;
    const formatted = formatDate(dateStr);
    fsDate.textContent = formatted;
    fsSubtitle.textContent = formatted ? `You vs Who — ${formatted}` : 'You vs Who';
  }

  // Desktop: click album art thumbnail to open fullscreen
  playerArt.addEventListener('click', openFullscreen);

  // Mobile: tap anywhere on mini bar except play/pause and skip buttons
  mobileBar.addEventListener('click', (e: MouseEvent) => {
    if (mobileControls.contains(e.target as Node)) return;
    openFullscreen();
  });

  // Close buttons
  fsCloseDesktop.addEventListener('click', closeFullscreen);
  fsCloseMobile.addEventListener('click', closeFullscreen);

  // --- Episode card clicks ---

  document.querySelectorAll('[data-audio-url]').forEach((card) => {
    card.addEventListener('click', () => {
      const url = card.getAttribute('data-audio-url')!;
      const title = card.getAttribute('data-title')!;
      const image = card.getAttribute('data-image') || '/fallback-artwork.svg';
      const date = card.getAttribute('data-date') || '';

      if (audio.src !== url) {
        audio.src = url;
        currentRawDate = date;
        playerTitle.textContent = title;
        playerTitleMobile.textContent = title;
        playerDate.textContent = formatDate(date);
        playerArt.src = image;
        playerArtMobile.src = image;
        updateFullscreenData(title, image, date);
        showPlayer();
        buildQueue(url);
        if (upNextVisible) updateUpNextPanel();
      }

      audio.play();
    });
  });

  // --- Play/pause ---

  function togglePlayPause() {
    if (audio.paused) {
      audio.play();
    } else {
      audio.pause();
    }
  }
  playPause.addEventListener('click', togglePlayPause);
  playPauseMobile.addEventListener('click', togglePlayPause);
  fsPlayPause.addEventListener('click', togglePlayPause);

  // --- Skip controls ---

  function doSkipBack() {
    audio.currentTime = Math.max(0, audio.currentTime - 15);
  }
  function doSkipForward() {
    audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 30);
  }
  skipBack.addEventListener('click', doSkipBack);
  skipForward.addEventListener('click', doSkipForward);
  skipForwardMobile.addEventListener('click', doSkipForward);
  fsSkipBack.addEventListener('click', doSkipBack);
  fsSkipForward.addEventListener('click', doSkipForward);

  // --- Speed control ---

  function cycleSpeed() {
    speedIndex = (speedIndex + 1) % SPEED_OPTIONS.length;
    audio.playbackRate = SPEED_OPTIONS[speedIndex];
    updateSpeedDisplay();
  }
  speedBtn.addEventListener('click', cycleSpeed);
  fsSpeedBtn.addEventListener('click', cycleSpeed);

  // --- Volume ---

  function handleVolumeInput(value: string) {
    audio.volume = parseFloat(value);
    audio.muted = false;
    syncVolumeSliders();
    updateVolumeIcon();
  }
  volumeSlider.addEventListener('input', () => handleVolumeInput(volumeSlider.value));
  fsVolumeSlider.addEventListener('input', () => handleVolumeInput(fsVolumeSlider.value));
  fsVolumeSliderMobile.addEventListener('input', () => handleVolumeInput(fsVolumeSliderMobile.value));

  function toggleMute() {
    if (audio.muted || audio.volume === 0) {
      audio.muted = false;
      audio.volume = volumeBeforeMute || 1;
      syncVolumeSliders();
    } else {
      volumeBeforeMute = audio.volume;
      audio.muted = true;
    }
    updateVolumeIcon();
  }
  volumeIcon.addEventListener('click', toggleMute);
  fsVolumeIcon.addEventListener('click', toggleMute);
  fsVolumeIconMobile.addEventListener('click', toggleMute);

  // --- Share ---

  let shareToastTimer: ReturnType<typeof setTimeout>;

  function showShareToast() {
    clearTimeout(shareToastTimer);
    fsShareToast.style.opacity = '1';
    shareToastTimer = setTimeout(() => {
      fsShareToast.style.opacity = '0';
    }, 1500);
  }

  fsShareBtn.addEventListener('click', async () => {
    const title = fsTitle.textContent || '';
    const url = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {}
      return;
    }

    try {
      await navigator.clipboard.writeText(url);
      showShareToast();
    } catch {}
  });

  // --- Audio events ---

  audio.addEventListener('play', () => updateIcons(true));
  audio.addEventListener('pause', () => updateIcons(false));

  audio.addEventListener('timeupdate', () => {
    if (!audio.duration) return;
    const pct = (audio.currentTime / audio.duration) * 100;

    progressFill.style.width = `${pct}%`;
    progressThumb.style.left = `${pct}%`;
    currentTimeEl.textContent = formatTime(audio.currentTime);

    fsProgressFill.style.width = `${pct}%`;
    fsProgressThumb.style.left = `${pct}%`;
    fsCurrentTime.textContent = formatTime(audio.currentTime);
    fsRemainingTime.textContent = formatRemainingTime(audio.duration - audio.currentTime);
  });

  audio.addEventListener('loadedmetadata', () => {
    totalTimeEl.textContent = formatTime(audio.duration);
    fsRemainingTime.textContent = formatRemainingTime(audio.duration);
  });

  // --- Progress bar seek ---

  function seekFromBar(bar: HTMLElement, e: MouseEvent) {
    if (!audio.duration) return;
    const rect = bar.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    audio.currentTime = pct * audio.duration;
  }
  progressBar.addEventListener('click', (e) => seekFromBar(progressBar, e));
  fsProgressBar.addEventListener('click', (e) => seekFromBar(fsProgressBar, e));

  // Touch-based scrubbing for fullscreen progress bar
  let fsScrubbing = false;

  fsProgressBar.addEventListener('touchstart', (e: TouchEvent) => {
    fsScrubbing = true;
    fsProgressThumb.style.opacity = '1';
    const touch = e.touches[0];
    seekFromTouch(touch);
  }, { passive: true });

  fsProgressBar.addEventListener('touchmove', (e: TouchEvent) => {
    if (!fsScrubbing) return;
    const touch = e.touches[0];
    seekFromTouch(touch);
  }, { passive: true });

  fsProgressBar.addEventListener('touchend', () => {
    fsScrubbing = false;
    fsProgressThumb.style.opacity = '';
  });

  function seekFromTouch(touch: Touch) {
    if (!audio.duration) return;
    const rect = fsProgressBar.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (touch.clientX - rect.left) / rect.width));
    audio.currentTime = pct * audio.duration;
  }

  // --- Up Next ---

  interface QueueEpisode {
    title: string;
    episode: string;
    audioUrl: string;
    imageUrl: string;
    date: string;
  }

  const episodeDataEl = document.getElementById('episode-data');
  const allEpisodes: QueueEpisode[] = episodeDataEl ? JSON.parse(episodeDataEl.textContent || '[]') : [];

  let upNextQueue: QueueEpisode[] = [];
  let currentEpisode: QueueEpisode | null = null;
  let upNextVisible = false;

  const fsCenter = document.getElementById('fs-center')!;
  const fsArtView = document.getElementById('fs-art-view')!;
  const fsUpNextPanel = document.getElementById('fs-up-next-panel')!;
  const fsUpNextBtn = document.getElementById('fs-up-next-btn')!;
  const unCurrentArt = document.getElementById('un-current-art') as HTMLImageElement;
  const unCurrentTitle = document.getElementById('un-current-title')!;
  const unCurrentDate = document.getElementById('un-current-date')!;
  const unShareBtn = document.getElementById('un-share-btn')!;
  const unList = document.getElementById('un-list')!;
  const unEmpty = document.getElementById('un-empty')!;
  const upNextBtnMini = document.getElementById('up-next-btn');

  function toggleUpNext() {
    upNextVisible = !upNextVisible;
    if (upNextVisible) {
      fsArtView.classList.add('hidden');
      fsUpNextPanel.classList.remove('hidden');
      fsCenter.classList.remove('justify-center');
      fsUpNextBtn.classList.remove('text-white/40');
      fsUpNextBtn.classList.add('text-white');
      updateUpNextPanel();
    } else {
      fsArtView.classList.remove('hidden');
      fsUpNextPanel.classList.add('hidden');
      fsCenter.classList.add('justify-center');
      fsUpNextBtn.classList.add('text-white/40');
      fsUpNextBtn.classList.remove('text-white');
    }
  }

  fsUpNextBtn.addEventListener('click', toggleUpNext);

  if (upNextBtnMini) {
    upNextBtnMini.classList.remove('opacity-50');
    upNextBtnMini.addEventListener('click', () => {
      if (!audio.src) return;
      openFullscreen();
      if (!upNextVisible) toggleUpNext();
    });
  }

  function buildQueue(playingUrl: string) {
    const idx = allEpisodes.findIndex(ep => ep.audioUrl === playingUrl);
    currentEpisode = idx >= 0 ? allEpisodes[idx] : null;
    upNextQueue = idx >= 0 ? [...allEpisodes.slice(idx + 1)] : [];
  }

  function updateUpNextPanel() {
    if (!upNextVisible) return;
    if (currentEpisode) {
      unCurrentArt.src = currentEpisode.imageUrl || '/fallback-artwork.svg';
      unCurrentTitle.textContent = currentEpisode.title;
      unCurrentDate.textContent = formatDate(currentEpisode.date);
    }
    renderQueue();
  }

  function renderQueue() {
    unList.innerHTML = '';
    if (upNextQueue.length === 0) {
      unList.classList.add('hidden');
      unEmpty.classList.remove('hidden');
      unEmpty.classList.add('flex');
      return;
    }
    unList.classList.remove('hidden');
    unEmpty.classList.remove('flex');
    unEmpty.classList.add('hidden');

    upNextQueue.forEach((ep, i) => {
      const item = createQueueItem(ep, i);
      makeDraggable(item);
      unList.appendChild(item);
    });
  }

  function createQueueItem(ep: QueueEpisode, i: number): HTMLElement {
    const item = document.createElement('div');
    item.className = 'un-item flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 select-none transition-colors';
    item.dataset.queueIndex = String(i);
    item.dataset.audioUrl = ep.audioUrl;

    const handle = document.createElement('div');
    handle.className = 'un-drag-handle flex items-center text-white/30 flex-shrink-0 cursor-grab active:cursor-grabbing';
    handle.innerHTML = '<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><circle cx="9" cy="7" r="1.5"/><circle cx="15" cy="7" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="9" cy="17" r="1.5"/><circle cx="15" cy="17" r="1.5"/></svg>';

    const img = document.createElement('img');
    img.src = ep.imageUrl || '/fallback-artwork.svg';
    img.alt = '';
    img.className = 'w-10 h-10 rounded-lg object-cover flex-shrink-0';

    const info = document.createElement('div');
    info.className = 'flex-1 min-w-0';

    const titleEl = document.createElement('p');
    titleEl.className = 'text-sm font-medium text-white truncate';
    titleEl.textContent = ep.title;

    const dateEl = document.createElement('p');
    dateEl.className = 'text-xs text-white/50';
    dateEl.textContent = formatDate(ep.date);

    info.append(titleEl, dateEl);
    item.append(handle, img, info);
    return item;
  }

  // --- Drag to reorder ---

  let dragState: { el: HTMLElement; startY: number; didDrag: boolean } | null = null;

  function makeDraggable(item: HTMLElement) {
    const handle = item.querySelector('.un-drag-handle') as HTMLElement;
    handle.style.touchAction = 'none';

    handle.addEventListener('pointerdown', (e: PointerEvent) => {
      if (dragState) return;
      e.preventDefault();
      handle.setPointerCapture(e.pointerId);
      dragState = { el: item, startY: e.clientY, didDrag: false };
      item.style.opacity = '0.4';
      item.style.background = 'rgba(255,255,255,0.08)';
    });

    handle.addEventListener('pointermove', (e: PointerEvent) => {
      if (!dragState || dragState.el !== item) return;
      if (Math.abs(e.clientY - dragState.startY) > 5) dragState.didDrag = true;
      if (!dragState.didDrag) return;

      const prev = item.previousElementSibling as HTMLElement | null;
      const next = item.nextElementSibling as HTMLElement | null;

      if (prev) {
        const rect = prev.getBoundingClientRect();
        if (e.clientY < rect.top + rect.height / 2) {
          unList.insertBefore(item, prev);
          syncQueueFromDOM();
        }
      }
      if (next) {
        const rect = next.getBoundingClientRect();
        if (e.clientY > rect.top + rect.height / 2) {
          unList.insertBefore(next, item);
          syncQueueFromDOM();
        }
      }
    });

    handle.addEventListener('pointerup', () => {
      if (!dragState || dragState.el !== item) return;
      item.style.opacity = '';
      item.style.background = '';
      dragState = null;
    });

    handle.addEventListener('pointercancel', () => {
      if (!dragState || dragState.el !== item) return;
      item.style.opacity = '';
      item.style.background = '';
      dragState = null;
    });

    handle.addEventListener('click', (e: MouseEvent) => e.stopPropagation());

    item.addEventListener('click', () => {
      if (dragState) return;
      const idx = parseInt(item.dataset.queueIndex!);
      playFromQueue(idx);
    });
  }

  function syncQueueFromDOM() {
    const items = Array.from(unList.children) as HTMLElement[];
    upNextQueue = items.map(item => {
      const url = item.dataset.audioUrl!;
      return allEpisodes.find(e => e.audioUrl === url)!;
    });
    items.forEach((item, i) => item.dataset.queueIndex = String(i));
  }

  function playFromQueue(queueIndex: number) {
    const ep = upNextQueue[queueIndex];
    if (!ep) return;
    upNextQueue.splice(queueIndex, 1);
    playEpisode(ep);
  }

  function playEpisode(ep: QueueEpisode) {
    currentEpisode = ep;
    audio.src = ep.audioUrl;
    currentRawDate = ep.date;
    audio.play();

    const image = ep.imageUrl || '/fallback-artwork.svg';
    playerTitle.textContent = ep.title;
    playerTitleMobile.textContent = ep.title;
    playerDate.textContent = formatDate(ep.date);
    playerArt.src = image;
    playerArtMobile.src = image;
    updateFullscreenData(ep.title, image, ep.date);
    showPlayer();
    updateUpNextPanel();
  }

  audio.addEventListener('ended', () => {
    if (upNextQueue.length === 0) return;
    const next = upNextQueue.shift()!;
    playEpisode(next);
  });

  unShareBtn.addEventListener('click', async () => {
    const title = unCurrentTitle.textContent || '';
    const url = window.location.href;
    if (navigator.share) {
      try { await navigator.share({ title, url }); } catch {}
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      showShareToast();
    } catch {}
  });
</script>
